# ==========================================
# Moobi Koperasi Pro - Global .gitignore
# ==========================================

# 1. Dependencies (Root, Web, & Mobile)
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Environment Variables & Secrets
.env
.env*.local
.env.development
.env.test
.env.production
*.env
# Jangan ignore .env.example agar tim backend punya referensi config
!.env.example
!*/.env.example

# 3. Next.js (Web Admin & Backend API)
.next/
*/.next/
out/
*/out/
build/
*/build/
.vercel
next-env.d.ts

# 4. Expo & React Native (Mobile App)
.expo/
*/.expo/
dist/
*/dist/
web-build/
*/web-build/
expo-env.d.ts
.metro-health-check*
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Generated Native Folders (Expo Prebuild)
mobile/ios/
mobile/android/

# 5. Database, Backend, & Laragon / MySQL
*.sql
*.sql.gz
*.dump
*.bak
*.db
*.sqlite
*.sqlite3
prisma/*.db
prisma/*.db-journal

# 6. Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log

# 7. OS & Editor Artifacts
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# IDEs
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# 8. TypeScript & Build Cache
*.tsbuildinfo
.turbo
